<section class="tab {{ tab.cssClass }} jujutsu-section" data-tab="{{ tab.id }}" data-group="{{ tab.group }}">

{{!-- ══════════════════ HEADER ══════════════════ --}}
<div class="manipulation-header jujutsu-card">
  <div class="manipulation-stage">
    <span class="stage-label">Estágio</span>
    {{#if (eq actor.system.manipulation.stage "master")}}
      <span class="stage-value stage-master">Mestre</span>
      <span class="stage-desc">61+ PM investidos</span>
    {{else if (eq actor.system.manipulation.stage "expert")}}
      <span class="stage-value stage-expert">Perito</span>
      <span class="stage-desc">21–60 PM investidos</span>
    {{else}}
      <span class="stage-value stage-beginner">Iniciante</span>
      <span class="stage-desc">1–20 PM investidos</span>
    {{/if}}
  </div>
  <div class="manipulation-resources">
    <div class="resource-box">
      <label>Pontos de Nen (PM)</label>
      <input type="number" name="system.curseResources.cursePoints"
        value="{{actor.system.curseResources.cursePoints}}" min="0" data-dtype="Number" />
    </div>
    <div class="resource-box">
      <label>PM Investidos</label>
      <input type="number" value="{{actor.system.manipulation.pointsInvested}}" readonly />
    </div>
  </div>
</div>

{{!-- ══════════════════ EFEITO DO ESTÁGIO ══════════════════ --}}
<div class="stage-effect-bar">
  {{#if (eq actor.system.manipulation.stage "beginner")}}
    <span class="stage-effect-icon">⚠️</span>
    <span><strong>Iniciante:</strong> Você deve usar uma ação bônus para ativar sua aura ou entrar em Zetsu.</span>
  {{else if (eq actor.system.manipulation.stage "expert")}}
    <span class="stage-effect-icon">✅</span>
    <span><strong>Perito:</strong> Você pode manter sua aura ativa enquanto dorme. Dormir não desativa habilidades com longas durações. Você recebe proficiência em Testes de Atributo de Espírito (Nen).</span>
  {{else}}
    <span class="stage-effect-icon">⭐</span>
    <span><strong>Mestre:</strong> Você recupera 4 dados de aura adicionais no fim de cada descanso longo. Você recebe <strong>maestria</strong> em Testes de Atributo de Espírito (Nen).</span>
  {{/if}}
</div>

{{!-- ══════════════════ EVOLUÇÃO NA PRÁTICA ══════════════════ --}}
<div class="evolution-section jujutsu-card">
  <div class="evolution-header">
    <h3 class="evolution-title">Evolução na Prática <span class="evolution-sub">— 10 dias de treinamento</span></h3>
    <button class="jujutsu-btn primary" data-action="intensiveTraining">
      <i class="fas fa-dumbbell"></i> Treinar
    </button>
  </div>
  <div class="evolution-counters">
    <div class="evo-counter-card {{#if actor.system.energy.intensiveTraining.maxEnergy}}has-training{{/if}}">
      <div class="evo-counter-info">
        <span class="evo-counter-label">PA Máximo</span>
        <span class="evo-counter-desc">+5 por treino</span>
      </div>
      <div class="evo-counter-badge">+{{actor.system.energy.intensiveTraining.maxEnergy}}</div>
      {{#if actor.system.energy.intensiveTraining.maxEnergy}}
      <button class="evo-undo-btn" data-action="undoIntensiveTraining" data-field="maxEnergy"><i class="fas fa-rotate-left"></i></button>
      {{/if}}
    </div>
    <div class="evo-counter-card {{#if actor.system.energy.intensiveTraining.generatedEnergy}}has-training{{/if}}">
      <div class="evo-counter-info">
        <span class="evo-counter-label">PA Gerada</span>
        <span class="evo-counter-desc">+1 por treino (máx. 20)</span>
      </div>
      <div class="evo-counter-badge">+{{actor.system.energy.intensiveTraining.generatedEnergy}}</div>
      {{#if actor.system.energy.intensiveTraining.generatedEnergy}}
      <button class="evo-undo-btn" data-action="undoIntensiveTraining" data-field="generatedEnergy"><i class="fas fa-rotate-left"></i></button>
      {{/if}}
    </div>
    <div class="evo-counter-card {{#if actor.system.energy.intensiveTraining.cursePoints}}has-training{{/if}}">
      <div class="evo-counter-info">
        <span class="evo-counter-label">Pontos de Nen</span>
        <span class="evo-counter-desc">+4 PM por treino</span>
      </div>
      <div class="evo-counter-badge">+{{actor.system.energy.intensiveTraining.cursePoints}}</div>
      {{#if actor.system.energy.intensiveTraining.cursePoints}}
      <button class="evo-undo-btn" data-action="undoIntensiveTraining" data-field="cursePoints"><i class="fas fa-rotate-left"></i></button>
      {{/if}}
    </div>
  </div>
</div>

{{!-- ══════════════════ SKILL TREE ══════════════════ --}}
<div class="nen-tree-wrapper" id="nen-tree-{{actor.id}}">

  {{#each manipulation.sections as |section|}}
  <div class="nen-section">
    <div class="nen-section-label">{{section.label}}</div>

    <div class="nen-principles-row">
    {{#each section.principles as |principle|}}

      {{!-- BLOCO VERTICAL: princípio em cima, habilidades abaixo --}}
      <div class="nen-principle-block">

        {{!-- CAIXA DO PRINCÍPIO (topo) --}}
        <div class="nen-box nen-pr
          {{#if principle.unlocked}}unlocked{{else if principle.isMasterGrant}}fundamental{{else if principle.canUnlock}}available{{else}}locked{{/if}}"
          data-action="clickNenNode"
          data-node-id="{{principle.id}}"
          data-node-type="pr"
          data-unlocked="{{principle.unlocked}}"
          data-master-grant="{{principle.isMasterGrant}}">
          <div class="nen-box-name">{{principle.label}}</div>
          <div class="nen-box-cost">
            {{#if principle.unlocked}}✓
            {{else if principle.isMasterGrant}}Grátis
            {{else}}{{principle.cost}} PM{{/if}}
          </div>
          {{!-- Botão de ação dentro do card --}}
          {{#unless principle.unlocked}}
            {{#if principle.canUnlockFree}}
              <button class="nen-card-btn nen-card-btn-unlock" data-action="unlockNenPrinciple" data-id="{{principle.id}}">
                Desbloquear (Grátis)
              </button>
            {{else if principle.canUnlock}}
              <button class="nen-card-btn nen-card-btn-unlock" data-action="unlockNenPrinciple" data-id="{{principle.id}}">
                Desbloquear
              </button>
            {{else}}
              <span class="nen-card-locked">🔒 Req. não atendido</span>
            {{/if}}
          {{/unless}}
        </div>

        {{!-- LINHA VERTICAL DO PRINCÍPIO PARA AS HABILIDADES --}}
        {{#if principle.abilities.length}}
        <div class="nen-down-line {{#if principle.unlocked}}active{{/if}}"></div>

        {{!-- LINHA HORIZONTAL DE DISTRIBUIÇÃO --}}
        <div class="nen-h-spread {{#if principle.unlocked}}active{{/if}}"></div>

        {{!-- HABILIDADES (em linha abaixo) --}}
        <div class="nen-abilities-row">
          {{#each principle.abilities as |ability|}}
          <div class="nen-ability-col">
            {{!-- SPUR VERTICAL DESCENDO PARA A HABILIDADE --}}
            <div class="nen-spur-down {{#if ability.unlocked}}active{{/if}}"></div>
            <div class="nen-box nen-ab
              {{#if ability.unlocked}}unlocked{{else if ability.canUnlock}}available{{else}}locked{{/if}}"
              data-action="clickNenNode"
              data-node-id="{{ability.id}}"
              data-node-type="ab"
              data-unlocked="{{ability.unlocked}}"
              data-pr-id="{{principle.id}}">
              <div class="nen-box-name">{{ability.label}}</div>
              <div class="nen-box-cost">
                {{#if ability.unlocked}}✓{{else}}{{ability.cost}} PM{{/if}}
              </div>
              {{!-- Botão dentro do card --}}
              {{#unless ability.unlocked}}
                {{#if ability.canUnlock}}
                <button class="nen-card-btn nen-card-btn-unlock" data-action="unlockNenAbility" data-id="{{ability.id}}">
                  Desbloquear
                </button>
                {{/if}}
              {{/unless}}
            </div>
          </div>
          {{/each}}
        </div>
        {{/if}}

      </div>

    {{/each}}
    </div>
  </div>
  {{/each}}

</div>

{{!-- TOOLTIP FLUTUANTE --}}
<div class="nen-tooltip" id="nen-tt-{{actor.id}}"></div>

{{!-- CONTEXT MENU --}}
<div class="nen-ctx-menu" id="nen-ctx-{{actor.id}}"></div>

</section>
