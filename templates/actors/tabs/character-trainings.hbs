<section class="tab {{ tab.cssClass }} jujutsu-section" data-tab="{{ tab.id }}" data-group="{{ tab.group }}">

  {{!-- ══════════════════════════ HEXÁGONO NEN ══════════════════════════ --}}
  <div class="nen-hexagon-wrapper">
    <svg class="nen-hexagon-svg" viewBox="0 0 300 300" xmlns="http://www.w3.org/2000/svg">

      {{!-- Anéis de referência --}}
      {{#each nenGridRings as |pts|}}
      <polygon points="{{pts}}" fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="1"/>
      {{/each}}

      {{!-- Eixos --}}
      {{#each nenAxes as |ax|}}
      <line x1="150" y1="150" x2="{{ax.x2}}" y2="{{ax.y2}}"
        stroke="rgba(255,255,255,0.12)" stroke-width="1"/>
      {{/each}}

      {{!-- Mancha de afinidade --}}
      <polygon points="{{nenHexPoints}}"
        fill="rgba(180,140,30,0.3)" stroke="rgba(220,180,60,0.85)" stroke-width="2"/>

      {{!-- Rótulos --}}
      {{#each nenLabels as |cat|}}
      <text x="{{cat.lx}}" y="{{cat.ly}}"
        text-anchor="middle" dominant-baseline="central"
        fill="{{cat.color}}" font-size="12" font-weight="bold">{{cat.abbrev}}</text>
      <text x="{{cat.lx}}" y="{{cat.ly2}}"
        text-anchor="middle" dominant-baseline="central"
        fill="rgba(255,255,255,0.45)" font-size="8">{{cat.pct}}%</text>
      {{/each}}

      {{!-- Centro --}}
      <circle cx="150" cy="150" r="2" fill="rgba(255,255,255,0.4)"/>

    </svg>
  </div>

  {{!-- ══════════════════════════ CARDS DE CATEGORIA ══════════════════════════ --}}
  <div class="nen-categories-grid">
    {{#each nenCategories as |cat|}}
    <div class="nen-category-card" data-category="{{cat.id}}">

      <div class="nen-cat-header">
        <span class="nen-cat-abbrev">{{cat.abbrev}}</span>
        <span class="nen-cat-name">{{cat.label}}</span>
        <span class="nen-cat-level">Nv. {{cat.level}}/10</span>
      </div>

      <div class="nen-cat-bar-track">
        <div class="nen-cat-bar-fill" style="width: {{cat.pct}}%"></div>
      </div>

      <div class="nen-cat-pips">
        {{#each cat.pips as |pip|}}
        <span class="nen-pip {{#if pip.filled}}filled{{/if}}">●</span>
        {{/each}}
      </div>

    </div>
    {{/each}}
  </div>

</section>
