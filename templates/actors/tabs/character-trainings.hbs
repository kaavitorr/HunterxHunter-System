<section class="tab {{ tab.cssClass }} jujutsu-section" data-tab="{{ tab.id }}" data-group="{{ tab.group }}">

  {{!-- ══════════════════ SELETOR DE CATEGORIA (NPC) ══════════════════ --}}
  {{#if npcCategoryOptions}}
  <div class="npc-category-selector">
    <label class="npc-cat-selector-label">
      <i class="fas fa-star"></i> Categoria Principal do NPC
    </label>
    <div class="npc-cat-selector-grid">
      {{#each npcCategoryOptions as |cat|}}
      <button type="button" class="npc-cat-btn {{#if cat.selected}}active{{/if}}"
        data-action="setNpcCategory"
        data-category="{{cat.id}}"
        style="--cat-color: {{cat.color}}"
        title="Definir {{cat.label}} como categoria principal">
        <img src="{{cat.icon}}" alt="{{cat.label}}" class="npc-cat-btn-icon" />
        <span class="npc-cat-btn-label">{{cat.label}}</span>
        {{#if cat.selected}}<i class="fas fa-check npc-cat-check"></i>{{/if}}
      </button>
      {{/each}}
    </div>
    {{#unless npcPrimaryCategory}}
    <p class="npc-cat-hint">⚠️ Sem categoria definida — sem restrição de afinidade.</p>
    {{/unless}}
  </div>
  {{/if}}

  {{!-- ══════════════════════════ TREINAR ATRIBUTO ══════════════════════════ --}}
  <div class="attr-train-card">
    <header class="attr-train-header">
      <i class="fas fa-dumbbell" inert></i>
      <span class="attr-train-title">Treinar Atributo</span>
      <span class="attr-train-pt">PT disponível: <strong>{{ attributeTraining.pt }}</strong></span>
    </header>
    <div class="attr-train-list">
      {{#each attributeTraining.abilities as |ab|}}
      <button type="button"
              class="attr-train-pip {{#if ab.selected}}selected{{/if}} {{#if ab.maxed}}maxed{{/if}} {{#unless ab.canTrain}}unaffordable{{/unless}}"
              data-action="selectAttributeToTrain" data-ability="{{ ab.id }}"
              {{#if ab.maxed}}disabled{{/if}}
              data-tooltip="{{#if ab.maxed}}Máximo (20){{else}}{{#if ab.canTrain}}{{ ab.cost }} PT para +1{{else}}Precisa {{ ab.cost }} PT (insuficiente){{/if}}{{/if}}">
        <span class="attr-train-abbr">{{ ab.abbr }}</span>
        <span class="attr-train-value">{{ ab.value }}</span>
      </button>
      {{/each}}
      <button type="button" class="attr-train-btn"
              data-action="trainAttribute"
              data-tooltip="Treinar o atributo selecionado">
        <i class="fas fa-dumbbell" inert></i>
        <span>TREINAR</span>
      </button>
    </div>
  </div>

  {{!-- ══════════════════════════ PONTOS DE TREINAMENTO ══════════════════════════ --}}
  <div class="attr-train-card nen-pt-card">
    <header class="attr-train-header">
      <i class="fas fa-coins" inert></i>
      <span class="attr-train-title">Pontos de Treinamento</span>
      <span class="attr-train-pt">Disponível: <strong>{{ attributeTraining.pt }}</strong></span>
    </header>
    <div class="nen-pt-bar">
      <div class="nen-pt-grid">
        <div class="nen-pt-field income">
          <label>PT Jogador</label>
          <input type="number" name="system.curseResources.trainingPoints"
            value="{{nenTrainingPoints}}" min="0" />
        </div>
        <div class="nen-pt-field income">
          <label>PT Narrador</label>
          <input type="number" name="system.curseResources.narratorTrainingPoints"
            value="{{nenNarratorTrainingPoints}}" min="0" />
        </div>
        <div class="nen-pt-field outflow readonly" data-tooltip="Calculado automaticamente pelas rolagens de treino — não é editável.">
          <label>PT Perdidos</label>
          <span class="nen-pt-value">{{nenLostTrainingPoints}}</span>
        </div>
        <div class="nen-pt-field outflow readonly" data-tooltip="Calculado automaticamente pelos treinos bem-sucedidos — não é editável.">
          <label>PT Gastos</label>
          <span class="nen-pt-value">{{nenSpentTrainingPoints}}</span>
        </div>
      </div>
      <div class="nen-pt-field readonly nen-pt-major">
        <label>Habilidades Principais</label>
        <span class="nen-major-value">{{nenMajorCount}} / {{nenMajorMax}}</span>
      </div>
    </div>
  </div>

  {{!-- ══════════════════════════ CATEGORIA HÍBRIDA ══════════════════════════ --}}
  {{#if isGM}}
    {{#if nenHybridCanHave}}
    <div class="nen-hybrid-gm">
      <label class="nen-hybrid-gm-title"><i class="fas fa-user-secret" inert></i> Categoria Híbrida (só o Narrador vê)</label>
      <div class="nen-hybrid-gm-row">
        <select name="system.nenHybrid" class="nen-hybrid-select">
          {{#each nenHybridOptions as |o|}}
          <option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>
          {{/each}}
        </select>
        <label class="nen-hybrid-reveal" data-tooltip="Quando marcado, o jogador passa a ver a híbrida escolhida (e só ela).">
          <input type="checkbox" name="system.nenHybridRevealed" {{#if nenHybridRevealed}}checked{{/if}}>
          <i class="fas fa-eye" inert></i> Revelar ao jogador
        </label>
      </div>
      <p class="nen-hybrid-hint">A híbrida permite treinar a 2ª categoria até o teto dela. {{#if nenHybridKey}}Atual: <strong>{{nenHybridLabel}}</strong>{{#unless nenHybridRevealed}} (oculta do jogador){{/unless}}.{{/if}}</p>
    </div>
    {{/if}}
  {{else}}
    {{#if nenHybridShowPlayer}}
    <div class="nen-hybrid-badge"><i class="fas fa-dna" inert></i> Categoria Híbrida: <strong>{{nenHybridLabel}}</strong></div>
    {{/if}}
  {{/if}}

  {{!-- ══════════════════════════ HEXÁGONO NEN ══════════════════════════ --}}
  <div class="nen-hexagon-wrapper">
    <svg class="nen-hexagon-svg" viewBox="0 0 340 340" xmlns="http://www.w3.org/2000/svg">

      {{!-- Eixos na cor de cada categoria --}}
      {{#each nenLabels as |cat|}}
      <line x1="160" y1="160" x2="{{cat.lx}}" y2="{{cat.ly}}"
        stroke="{{cat.color}}" stroke-width="1.5" opacity="0.5"/>
      {{/each}}

      {{!-- Moldura hexagonal ligando as categorias (linha forte) --}}
      <polygon points="{{nenOuterPoints}}" fill="none"
        stroke="rgba(0,0,0,0.5)" stroke-width="6" stroke-linejoin="round"/>
      <polygon points="{{nenOuterPoints}}" fill="none"
        stroke="rgba(236,239,246,0.8)" stroke-width="2.5" stroke-linejoin="round"/>

      {{!-- Fill do poligono na cor da categoria principal --}}
      <polygon points="{{nenHexPoints}}"
        fill="{{nenPrimaryColor}}" fill-opacity="0.42"
        stroke="{{nenPrimaryColor}}" stroke-opacity="1" stroke-width="2.5"/>

      {{!-- Labels e pontos coloridos por categoria — Kanji centralizado --}}
      {{#each nenLabels as |cat|}}
      {{!-- Ponto colorido no vertice --}}
      <circle cx="{{cat.lx}}" cy="{{cat.ly}}" r="21"
        fill="{{cat.color}}" opacity="0.92" stroke="rgba(0,0,0,0.6)" stroke-width="1.5"/>
      {{!-- Kanji da categoria --}}
      <text x="{{cat.lx}}" y="{{cat.ly}}" text-anchor="middle" dominant-baseline="central"
        fill="rgba(0,0,0,0.92)" font-size="22" font-weight="800"
        font-family="'Yu Mincho', 'MS Mincho', 'Hiragino Mincho ProN', serif">{{cat.kanji}}</text>
      {{/each}}

      <circle cx="160" cy="160" r="3" fill="rgba(255,255,255,0.5)"/>
    </svg>
  </div>

  {{!-- ══════════════════════════ CARDS DE CATEGORIA ══════════════════════════ --}}
  <div class="nen-categories-list">
    {{#each nenCategories as |cat|}}
    <div class="nen-category-card" data-category="{{cat.id}}" style="--cat-color: {{cat.color}}">

      <div class="nen-cat-header-row">
      {{!-- ── IDENTIDADE: anel de progresso + ícone + nome ── --}}
      {{#if cat.canTrain}}
      <button type="button" class="nen-cat-identity item-action" data-action="trainNenCategory" data-category="{{cat.id}}"
        title="Treinar {{cat.label}} — Nv.{{cat.nextLevel}}">
        <div class="nen-cat-ring" style="--pct: {{cat.pct}}">
          <img class="nen-cat-icon" src="{{cat.icon}}" alt="{{cat.label}}" />
        </div>
        <span class="nen-train-name">{{cat.label}}</span>
      </button>
      {{else}}
      <div class="nen-cat-identity locked">
        <div class="nen-cat-ring" style="--pct: {{cat.pct}}">
          <img class="nen-cat-icon" src="{{cat.icon}}" alt="{{cat.label}}" />
        </div>
        <span class="nen-train-name">{{cat.label}}</span>
      </div>
      {{/if}}

      <div class="nen-cat-divider"></div>

      {{!-- ── INFO: nível + custos + barra segmentada ── --}}
      <div class="nen-cat-info">
        <div class="nen-cat-lvl-row">
          <span class="nen-cat-level-num" style="color: {{cat.color}}">{{cat.level}}</span>
          <span class="nen-cat-level-max">/10</span>
          {{#if cat.canTrain}}
          <span class="nen-train-sub">Treinar para o nível {{cat.nextLevel}}</span>
          {{else}}
            {{#if cat.blockedReason}}
            <span class="nen-train-sub muted">⛔ {{cat.blockedReason}}</span>
            {{else}}
            <span class="nen-train-sub muted">✦ Nível Máximo</span>
            {{/if}}
          {{/if}}
        </div>

        {{#if cat.canTrain}}
        <div class="nen-cat-pills">
          <span class="nen-cat-pill {{#if cat.entendimentoDiscount}}has-discount{{/if}}"
                {{#if cat.entendimentoDiscount}}data-tooltip="Reduzido pela metade por Entendimento"{{/if}}>
            {{#if cat.entendimentoDiscount}}<i class="fas fa-percent" inert></i>{{/if}}{{cat.nextPt}} PT
          </span>
          <span class="nen-cat-pill">{{cat.nextPa}} PA</span>
          <span class="nen-cat-pill">CD {{cat.currentDC}}</span>
        </div>
        {{/if}}

        <div class="nen-cat-segbar">
          {{#each cat.levelSegments as |on|}}
          <i class="{{#if on}}on{{/if}}"></i>
          {{/each}}
        </div>
      </div>
      </div>

      {{!-- ── HABILIDADES MENORES ── --}}
      {{#if cat.minorSlots.length}}
      <div class="nen-abilities-section">
        <div class="nen-abilities-title minor">Habilidades Menores</div>
        <div class="nen-ability-grid">
          {{#each cat.minorSlots as |slot|}}
          <div class="nen-ability-card minor {{#if slot.reached}}reached{{else}}locked{{/if}}"
            {{#if slot.reference}}data-reference-tooltip="{{slot.reference}}"{{/if}}>
            <div class="nen-ability-card-top">
              <span class="nen-ability-lvl-badge" style="{{#if slot.reached}}background: {{slot.color}}20; border-color: {{slot.color}}60; color: {{slot.color}}{{/if}}">Nv.{{slot.level}}</span>
              <span class="nen-ability-card-name {{#unless slot.reached}}muted{{/unless}}">{{#if slot.empty}}🔒 Bloqueada{{else}}{{slot.label}}{{/if}}</span>
            </div>
          </div>
          {{/each}}
        </div>
      </div>
      {{/if}}

      {{!-- ── HABILIDADES PRINCIPAIS ── --}}
      <div class="nen-abilities-section">
        <div class="nen-abilities-title major">Habilidades Principais</div>
        <div class="nen-ability-grid">
          {{#each cat.majorSlots as |slot|}}

          {{#if slot.unlocked}}
          {{!-- DESBLOQUEADA — clique direito para desfazer --}}
          <div class="nen-ability-card major unlocked interactive {{#if slot.exclusive}}exclusive{{/if}}"
            style="--cat-color: {{slot.color}}; background: {{slot.color}}18; border-color: {{slot.color}}60"
            data-action="undoNenMajor"
            data-category="{{slot.categoryId}}"
            data-ability="{{slot.id}}"
            data-label="{{slot.label}}"
            data-tooltip="Clique com o botão direito para desfazer"
            {{#if slot.reference}}data-reference-tooltip="{{slot.reference}}"{{/if}}>
            <div class="nen-ability-card-top">
              <span class="nen-ability-lvl-badge" style="border-color: {{slot.color}}60; color: {{slot.color}}">Nv.{{slot.level}}</span>
              <span class="nen-ability-card-name">{{slot.label}}</span>
              {{#if slot.exclusive}}<span class="nen-major-excl-badge">Exclusiva</span>{{/if}}
            </div>
          </div>

          {{else if slot.reached}}
          {{!-- DISPONÍVEL — clique no card para aprender --}}
          <div class="nen-ability-card major available {{#if slot.canUnlock}}interactive{{/if}} {{#if slot.exclusive}}exclusive{{/if}}"
            style="--cat-color: {{slot.color}}; background: {{slot.color}}10; border-color: {{slot.color}}40"
            {{#if slot.canUnlock}}
            data-action="unlockNenMajor"
            data-category="{{slot.categoryId}}"
            data-ability="{{slot.id}}"
            data-label="{{slot.label}}"
            data-tooltip="Clique para aprender"
            {{/if}}
            {{#if slot.reference}}data-reference-tooltip="{{slot.reference}}"{{/if}}>
            <div class="nen-ability-card-top">
              <span class="nen-ability-lvl-badge" style="border-color: {{slot.color}}50; color: {{slot.color}}">Nv.{{slot.level}}</span>
              <span class="nen-ability-card-name">{{slot.label}}</span>
              {{#unless slot.canUnlock}}
              <span class="nen-ability-badge locked">🔒 Limite</span>
              {{/unless}}
            </div>
          </div>

          {{else}}
          {{!-- BLOQUEADA --}}
          <div class="nen-ability-card major locked-preview"
            {{#if slot.reference}}data-reference-tooltip="{{slot.reference}}"{{/if}}>
            <div class="nen-ability-card-top">
              <span class="nen-ability-lvl-badge locked-badge">🔒 Nv.{{slot.level}}</span>
              <span class="nen-ability-card-name muted">{{#if slot.empty}}???{{else}}{{slot.label}}{{/if}}</span>
            </div>
            {{#unless slot.empty}}
            {{/unless}}
          </div>
          {{/if}}

          {{/each}}
        </div>
      </div>

    </div>
    {{/each}}
  </div>

</section>
